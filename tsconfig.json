{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/main.ts",
    "src/network",
    "src/art/network",
    "src/engine/network-playback.ts",
    "src/ui/network-notebook.ts",
    "src/scenarios/network.ts",
    "tests/network"
  ]
}
